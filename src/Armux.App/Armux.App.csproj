<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <RootNamespace>Armux.App</RootNamespace>
    <!-- The app is armux.exe; the CLI ships beside it as armux.com (deviation D-11). -->
    <AssemblyName>armux</AssemblyName>
    <!-- Program.cs hands CLI command lines to armux.com before the UI starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Platforms>ARM64</Platforms>
    <Platform>ARM64</Platform>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <SelfContained>false</SelfContained>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\armux.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- FontList calls GDI through a function-pointer callback. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Release builds ship as NativeAOT: idle 95 MB working set vs 135 MB with the JIT, start-up 156 ms vs 320 ms
         (ARCHITECTURE.md section 7). AOT needs a self-contained publish; `dotnet build` stays framework-dependent. -->
    <PublishAot>true</PublishAot>
    <SelfContained Condition="'$(_IsPublishing)' == 'true'">true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <!-- Platform SDK, approved 2026-10-25 (Microsoft Software License Terms). See ARCHITECTURE.md section 10. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  </ItemGroup>
  <ItemGroup>
    <!-- Zed's default fonts: Lilex (terminal) and IBM Plex Sans (interface), SIL OFL-1.1, approved for fonts
         2026-10-26. Their license files must ship with them. -->
    <Content Include="Assets\Fonts\*.ttf;Assets\Fonts\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- The window and taskbar icon (AppWindow.SetIcon reads it from the app folder); the exe embeds it too. -->
    <Content Include="Assets\armux.ico;Assets\armux-logo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Armux.Core\Armux.Core.csproj" />
  </ItemGroup>
</Project>
