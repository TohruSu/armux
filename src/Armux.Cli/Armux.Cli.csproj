<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- `armux` on the command line, like cmux's `cmux` CLI. Built as armux-cli.exe and published as armux.com
         beside the app's armux.exe (deviation D-11). -->
    <AssemblyName>armux-cli</AssemblyName>
    <RootNamespace>Armux.Cli</RootNamespace>
    <ApplicationIcon>..\Armux.App\Assets\armux.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <!-- PowerShell and cmd run .com before .exe, so typing `armux` runs the CLI while Explorer and the Start menu open
       the app (Visual Studio ships devenv.com and devenv.exe the same way). -->
  <Target Name="ShipAsCom" AfterTargets="CopyNativeBinary">
    <Move SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(PublishDir)armux.com" OverwriteReadOnlyFiles="true" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\Armux.Core\Armux.Core.csproj" />
  </ItemGroup>
</Project>
