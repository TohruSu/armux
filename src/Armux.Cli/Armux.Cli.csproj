<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- `armux` on the command line, like cmux's `cmux` CLI. The app is ArmuxApp.exe (deviation D-11). -->
    <AssemblyName>armux</AssemblyName>
    <RootNamespace>Armux.Cli</RootNamespace>
    <ApplicationIcon>..\Armux.App\Assets\armux.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Armux.Core\Armux.Core.csproj" />
  </ItemGroup>
</Project>
